# Base URL for the application
NEXT_PUBLIC_BASE_URL=https://japan-app.vercel.app

# Allowed CORS origins (comma-separated)
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,https://japan-app.vercel.app

# Encryption key for localStorage data (generate a secure random string)
# Use: openssl rand -base64 32
NEXT_PUBLIC_ENCRYPTION_KEY=your-secure-encryption-key-here

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Upstash Redis Configuration for Production Rate Limiting
# Get these values from your Upstash Console: https://console.upstash.com/
# Leave empty to automatically fallback to in-memory rate limiting (development mode)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
